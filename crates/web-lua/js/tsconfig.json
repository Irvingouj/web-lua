{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "../../..",
    "baseUrl": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@pi-oxide/extension-lua": ["../../extension-lua/js/src/main/index.ts"],
      "@pi-oxide/extension-lua/shared": ["../../extension-lua/js/src/shared/index.ts"],
      "@pi-oxide/extension-lua/shared/*": ["../../extension-lua/js/src/shared/*"]
    }
  },
  "include": ["*.ts", "../../extension-lua/js/src/**/*.ts"],
  "exclude": ["dist", "*.test.ts", "vitest.config.ts"]
}
