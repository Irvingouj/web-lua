  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "wasm": "cd .. && PATH=\"$HOME/.rustup/toolchains/stable-aarch64-apple-darwin/bin:$PATH\" wasm-pack build crates/piccolo-notebook-wasm --target web --out-dir ../../web/pkg",
    "prebuild": "npm run wasm",
    "deploy": "npm run build && npx gh-pages -d dist",
