{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "files": {
    "includes": [
      "web/src/**/*.ts",
      "web/tests/**/*.ts",
      "crates/*/js/**/*.ts",
      "packages/**/*.ts",
      "!!**/*.d.ts"
    ]
  }
}
